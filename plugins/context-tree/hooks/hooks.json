{
  "description": "Persist and restore Context Tree continuation state.",
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/hook.mjs\"", "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\hook.mjs\"", "additionalContextLimit": 1600, "timeout": 30 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/hook.mjs\"", "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\hook.mjs\"", "additionalContextLimit": 1200, "timeout": 30 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/hook.mjs\"", "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\hook.mjs\"", "timeout": 30 }] }],
    "PreCompact": [{ "matcher": "manual|auto", "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/hook.mjs\"", "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\hook.mjs\"", "timeout": 120 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/hook.mjs\"", "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\hook.mjs\"", "timeout": 10 }] }]
  }
}
